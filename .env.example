# Store all API keys as environment variables. NEVER commit .env or print keys.
# For GitHub Actions, DO NOT push .env — add these keys under:
#   GitHub Repo -> Settings -> Secrets and variables -> Actions

# ======================== REPOSITORY SECRETS (PRIVATE) ========================

# 1. FREE Telegram Bot Delivery (100% FREE - create via @BotFather in Telegram)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 2. FREE Twitch Helix API (100% FREE - https://dev.twitch.tv/console/apps)
#    Required for automatic daily cloud clip scouting on GitHub Actions!
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# 3. FREE-TIER Scrape Creators API (100 free credits on signup, no credit card)
#    Optional: used to auto-sync TikTok & Instagram views/shares/followers.
SCRAPE_CREATORS_API_KEY=""
SCRAPE_CREATORS_CREDIT_CAP="40"

# 4. OPTIONAL FREE OpenRouter AI (https://openrouter.ai — free models available)
#    Optional: writes custom hooks/punchlines/captions in GitHub Actions cloud runs.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3.5-super-vl:free"

# ======================== REPOSITORY VARIABLES (PUBLIC) =======================

# Your clip page handles for automatic follower & view monitoring (scripts/sync_stats.py)
YT_CHANNEL_URL="https://youtube.com/@leonidachao?si=6Dk9Xq8MsV8mkTBS"
TIKTOK_HANDLE="https://www.tiktok.com/@leonida.chaos4"
IG_HANDLE="https://www.instagram.com/leonida_chaos4?evlk=dGdvZTlybzVsNHlz&utm_source=qr"

# Cloud pipeline daily settings
DAILY_CLIP_COUNT="5"
TARGET_CLIP_SEC="30"
REQUIRE_GTA6_ONLY="true"
PAGE_NAME="Leonida Chaos"
TIMEZONE="Africa/Lagos"

# Optional self-hosted Postiz scheduler (only if switching away from Telegram manual posting)
PUBLISHER_BACKEND="queue"
POSTIZ_API_URL="http://localhost:5000/public/v1"
POSTIZ_API_KEY=""
ALLOWED_IG_ACCOUNT_ID="clip-ig-unconfigured"
ALLOWED_TIKTOK_ACCOUNT_ID="clip-tiktok-unconfigured"
ALLOWED_YOUTUBE_ACCOUNT_ID="clip-youtube-unconfigured"
